# Public URL of the deployed site. Used for canonical links, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://portfolio-gamma-six-99.vercel.app

# Contact form delivery through Resend (https://resend.com). Leave empty to disable the form;
# visitors are then pointed to email and LinkedIn instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional. Needs a domain verified in Resend. Without it, Resend's test sender is used,
# which only delivers to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=
